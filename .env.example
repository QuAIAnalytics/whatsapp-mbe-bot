# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# String que TU inventas; debe ser igual al que pones en el panel de Meta:
WHATSAPP_VERIFY_TOKEN=mbe-verify-2026
WHATSAPP_API_VERSION=v22.0

# Para que se sienta humano: muestra "escribiendo..." y demora N segundos al responder.
TYPING_MIN_SECONDS=5
TYPING_MAX_SECONDS=20

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Paquetes (MBE) ---
# Google Sheet publicado como CSV (Archivo > Compartir > Publicar en la web > CSV).
# Debe tener una columna de telefono/whatsapp para buscar al cliente.
MBE_SHEET_CSV_URL=

# --- Chatwoot (deshabilitado en este despliegue) ---
CHATWOOT=false
# CHATWOOT_BASE_URL=https://app.chatwoot.com
# CHATWOOT_ACCOUNT_ID=
# CHATWOOT_INBOX_ID=
# CHATWOOT_API_TOKEN=
# Secret del Agent Bot (Chatwoot > Integraciones > Agent Bots), NO el access
# token. Verifica la firma HMAC de los webhooks entrantes en /chatwoot. Si se
# deja vacío, no se puede verificar y se deja pasar todo (sin romper nada,
# pero sin la protección).
# CHATWOOT_WEBHOOK_SECRET=
